---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config';
import { t } from '../i18n';
import { getPublishedPosts, postUrl } from '../utils/posts';

const posts = await getPublishedPosts();
const blogPosts = posts.filter((p) => {
  const slug = p.id.replace(/\.mdx?$/, '');
  return !['about', '404'].includes(slug);
});
const indexPosts = blogPosts.slice(0, site.maxPostsOnIndex);
const i18n = t(site.language);
const canonicalUrl = new URL('/', Astro.site).href;
---

<BaseLayout title={i18n.navHome} pageId="index" canonicalUrl={canonicalUrl}>
  <section class="post-list">
    {indexPosts.length === 0 ? (
      <p class="empty-state">{i18n.noPosts}</p>
    ) : (
      indexPosts.map((post) => <PostCard post={post} />)
    )}
  </section>
  {blogPosts.length >= site.maxPostsOnIndex && (
    <p class="read-more">
      <a href="/archive/">{i18n.readAllArchive} →</a>
    </p>
  )}
</BaseLayout>
