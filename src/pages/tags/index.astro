---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site.config';
import { t } from '../../i18n';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const blogPosts = posts.filter((p) => {
  const slug = p.id.replace(/\.mdx?$/, '');
  return !['about', '404'].includes(slug);
});
const tags = getAllTags(blogPosts);
const i18n = t(site.language);
---

<BaseLayout title={i18n.navTags} pageId="tags">
  <h1>{i18n.tagsListHeading}</h1>
  {tags.length === 0 ? (
    <p class="empty-state">{i18n.noTags}</p>
  ) : (
    <ul class="tag-cloud">
      {tags.map((tag) => {
        const count = blogPosts.filter((p) => p.data.tags.includes(tag)).length;
        return (
          <li>
            <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            <span class="tag-count">({count})</span>
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>
