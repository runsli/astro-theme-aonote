---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { t } from '../i18n';
import { getEntry, render } from 'astro:content';

const i18n = t(site.language);
const entry = await getEntry('posts', 'about');
if (!entry) throw new Error('Missing src/content/posts/about.md');
const { Content } = await render(entry);
const canonicalUrl = new URL('/about/', Astro.site).href;
---

<BaseLayout title={i18n.navAbout} pageId="about" canonicalUrl={canonicalUrl}>
  <div class="page-content prose">
    <Content />
  </div>
</BaseLayout>
