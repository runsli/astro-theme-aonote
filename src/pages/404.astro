---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', '404');
if (!entry) throw new Error('Missing src/content/pages/404.md');
const { Content } = await render(entry);
---

<BaseLayout title="404" pageId="404" noindex>
  <div class="post-content">
    <Content />
  </div>

  <script is:inline>
    // Auto-redirect trailing-slash mismatches so readers never see a raw 404
    // for a page that exists with the other slash style.
    (function () {
      var path = window.location.pathname;
      // Only act on paths that don't look like file requests
      if (/\.[a-zA-Z0-9]{1,6}$/.test(path)) return;

      var alt;
      if (path.endsWith('/')) {
        alt = path.slice(0, -1);
      } else {
        alt = path + '/';
      }
      if (alt === path) return;

      // Try the alternative URL; redirect if it exists.
      var xhr = new XMLHttpRequest();
      xhr.open('HEAD', alt);
      xhr.onreadystatechange = function () {
        if (xhr.readyState === 4 && xhr.status === 200) {
          window.location.replace(alt);
        }
      };
      xhr.send();
    })();
  </script>
</BaseLayout>
