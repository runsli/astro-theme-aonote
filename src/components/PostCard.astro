---
import type { Post } from '../utils/posts';
import { formatDate, postUrl } from '../utils/posts';
import { site } from '../site.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const url = postUrl(post);
const dateStr = formatDate(post.data.date, site.language);
---

<article class="post-card" itemscope itemtype="https://schema.org/BlogPosting">
  <h2 class="post-card-title">
    <a href={url} itemprop="url">
      <span itemprop="headline">{post.data.title}</span>
    </a>
  </h2>
  <p class="post-meta">
    <time datetime={post.data.date.toISOString()} itemprop="datePublished">{dateStr}</time>
  </p>
  {post.data.tags.length > 0 && (
    <ul class="post-tags">
      {post.data.tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag)}/`} rel="tag">{tag}</a>
        </li>
      ))}
    </ul>
  )}
  {post.data.summary && <p class="post-excerpt" itemprop="description">{post.data.summary}</p>}
</article>
